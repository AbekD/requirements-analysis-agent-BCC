# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Имя модели Gemini (необязательно; по умолчанию см. src/config.py)
GEMINI_MODEL=your_supported_model_name
# Лимит запросов в минуту (необязательно; для бесплатного тарифа ~10)
GEMINI_REQUESTS_PER_MINUTE=10
